{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "src/backend/.venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--app-dir", "src/backend", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "src/frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
